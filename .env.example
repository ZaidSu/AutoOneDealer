# NOTHING HERE IS NEEDED YET. With none of these set, the site runs in preview mode (see README).
# Fill them in when you want real Google sign-in and a real database.
#
# Copy to .env.local for local development. Never commit real values. In Vercel, add the same names under
# Project > Settings > Environment Variables (Production).

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud.
# Production: https://YOUR-DOMAIN/api/google-callback      Local: http://localhost:3000/api/google-callback
GOOGLE_REDIRECT_URI=

# At least 32 random characters. Encrypts the sign-in cookie.
SESSION_SECRET=

# The Google email that owns this workspace. If STAFF_ACCESS is empty, this is the only person who can sign in.
OWNER_EMAIL=
# Optional. Comma-separated list of email:role. Roles: owner (full access), accountant (view and download only).
# Example: you@gmail.com:owner,cpa@firm.com:accountant
STAFF_ACCESS=

# Supabase > Connect > Transaction pooler (port 6543), with your database password filled in.
# The tables are created automatically the first time the site connects.
DATABASE_URL=

# Optional. The email shown on the public website and legal pages (default marketplacewholesalellc@gmail.com).
CONTACT_EMAIL=
