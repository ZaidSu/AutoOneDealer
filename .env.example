# Copy to .env.local for local development. Never commit real values.

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud.
# Production: https://auto-one-dealer.vercel.app/api/google-callback
GOOGLE_REDIRECT_URI=

# At least 32 random characters. Encrypts session cookies.
SESSION_SECRET=

# The dealership mailbox AutoDash may connect to (e.g. the Auto One Gmail).
# If STAFF_ACCESS is empty, this address is also the only staff member allowed to sign in (as owner).
GMAIL_ALLOWED_EMAIL=

# Optional. Comma-separated staff list as email:role.
# Roles: owner, manager, salesperson, developer
# Example: owner@autoone.com:owner,sam@autoone.com:salesperson
STAFF_ACCESS=

# Set to true to require Google sign-in (staff allowlist). Unset = open username/password screen.
REQUIRE_GOOGLE_SIGNIN=

# Supabase > Connect > Transaction pooler (port 6543), with your database password filled in.
DATABASE_URL=

# Optional. Display name (defaults to "Auto One Motors").
DEALERSHIP_NAME=
# Optional. Set to 1 to log SQL queries to the terminal.
DB_DEBUG=
# Optional. Set to 1 to log every step of each page load to the server logs (Vercel -> Logs).
AUTODASH_DEBUG=
# Optional. AutoDash only shows customers, leads and emails from this date on (YYYY-MM-DD). Default 2026-09-30.
DATA_START=

# AI email replies. Your Anthropic API key (console.anthropic.com -> API Keys). Never commit it or paste it anywhere else.
ANTHROPIC_API_KEY=
# Optional. Which Claude model writes the replies (default claude-haiku-4-5-20251001).
AI_MODEL=
# The timer: a long random password that cron-job.org sends when it calls /api/cron/tick every 5 minutes.
CRON_SECRET=

# Billing: card payments through Stripe. Secret key from dashboard.stripe.com -> Developers -> API keys
# (sk_test_... while testing, sk_live_... for real payments), and the webhook signing secret (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. The AI only replies to leads from this day on (YYYY-MM-DD). Default 2026-09-30.
AI_REPLIES_START=

# Texting (Twilio). From console.twilio.com -> Account Info. Number like +14693171764.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: send through a Messaging Service (MG...) instead of the number directly.
TWILIO_MESSAGING_SERVICE_SID=
# Optional: the site's public address, if Twilio's signature check ever fails (e.g. https://auto-one-dealer.vercel.app).
APP_URL=

# Bank payments (ACH) through GoCardless. Access token from manage.gocardless.com -> Developers -> Create access token
# (sandbox_... for testing, live_...). Webhook secret from Developers -> Webhooks, pointed at /api/billing/gocardless/webhook.
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=

# Billing starts by itself from this month (YYYY-MM): that month's bill is created automatically, then one each month.
BILLING_START=

# Optional. Where AutoDash checks if a car is still for sale (default: the Auto One Motors inventory page).
INVENTORY_URL=
