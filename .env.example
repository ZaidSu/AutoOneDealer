# Copy to .env.local for local development. Never commit real values.

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud.
# Production: https://auto-one-dealer.vercel.app/api/google-callback
GOOGLE_REDIRECT_URI=

# At least 32 random characters. Encrypts session cookies.
SESSION_SECRET=

# The dealership mailbox AutoDash may connect to (e.g. the Auto One Gmail).
# If STAFF_ACCESS is empty, this address is also the only staff member allowed to sign in (as owner).
GMAIL_ALLOWED_EMAIL=

# Optional. Comma-separated staff list as email:role.
# Roles: owner, manager, salesperson, developer
# Example: owner@autoone.com:owner,sam@autoone.com:salesperson
STAFF_ACCESS=

# Set to true to require Google sign-in (staff allowlist). Unset = open username/password screen.
REQUIRE_GOOGLE_SIGNIN=

# Supabase > Connect > Transaction pooler (port 6543), with your database password filled in.
DATABASE_URL=

# Optional. Display name (defaults to "Auto One Motors").
DEALERSHIP_NAME=
# Optional. Set to 1 to log SQL queries to the terminal.
DB_DEBUG=
