{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev server (debug server code)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Unit tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test"
    }
  ]
}
